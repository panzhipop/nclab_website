---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import BulletList from "../components/BulletList.astro";
import { withBase } from "../lib/url";
import prof from "../data/professor.json";

// 經歷依起始日期由新到舊
const experience = [...prof.experience].sort((a, b) => b.start.localeCompare(a.start));

// 全站條列一律依年份由新到舊。年份缺漏（0 或 null）的排最後。
const byYearDesc = (a: any, b: any) => (b.y || 0) - (a.y || 0);

const journals = [...prof.journals].sort(byYearDesc);
const conferences = [...prof.conferences].sort(byYearDesc);
const awards = [...prof.awards].sort(byYearDesc);
const guidance = [...prof.guidance].sort(byYearDesc);
const books = [...prof.books].sort(byYearDesc);

// 條目的副標。原始資料很多欄位是空的或 0，filter(Boolean) 會把它們
// 濾掉；全部都缺時回傳空字串，樣板就不輸出那個 span。
const metaOf = (...parts: (string | number | null | undefined)[]) =>
  parts.filter(Boolean).join("，");

// 尾端的年份／期間改用「空一格 + 括號」而不是再接一個逗號。
// 前面的欄位之間本來就用逗號串，年份再用逗號接上去會分不出層次。
const withYear = (text: string, year: string | number | null | undefined) =>
  year ? `${text} (${year})` : text;

// 一則論文串成一行。收錄標記和年份一起放進尾端括號。
function pubLine(p: any): string {
  const marks = [...(p.tags ?? []), p.y || null].filter(Boolean);
  return withYear(metaOf(p.t, p.v, p.d, p.n), marks.length ? marks.join(", ") : null);
}

// 各區塊先在這裡攤平成字串陣列，樣板就只負責排版。
// BulletList 預設顯示前 5 筆，超過的收在「顯示更多」後面。
const lists = {
  journals: journals.map(pubLine),
  conferences: conferences.map(pubLine),
  nsc: prof.nscProjects.map((x) => withYear(metaOf(x.t, x.c), x.p)),
  other: prof.otherProjects.map((x) => withYear(x.t, x.p)),
  books: books.map((b) => withYear(b.t, b.y)),
  patents: prof.patents.map((b) => b.t),
  awards: awards.map((a) => withYear(a.t, a.y)),
  guidance: guidance.map((g) => withYear(metaOf(g.t, g.k), g.y)),
};

const sections = [
  { id: "profile", label: "個人資料" },
  { id: "experience", label: "經歷" },
  { id: "publications", label: "學術著作" },
  { id: "projects", label: "研究計畫" },
  { id: "books", label: "專書與專利" },
  { id: "awards", label: "榮譽" },
  { id: "guidance", label: "指導成果" },
];
---

<BaseLayout title="指導教授" current="/professor">
  <PageHero title="指導教授" mobileOnly />

  <div class="page-body wrap prof-layout">
    <aside class="toc">
      <p class="toc-title">目錄</p>
      <nav aria-label="本頁章節">
        {sections.map((s) => (
          <a href={`#${s.id}`} data-toc-link={s.id}>{s.label}</a>
        ))}
      </nav>
    </aside>

    <div class="prof-main">
    {/* ---------- 個人資料 ---------- */}
    <section class="page-section" id="profile">
      <h2 class="page-section-title">個人資料</h2>

      <div class="prof-card">
        <img
          class="prof-photo"
          src={withBase(prof.photo)}
          alt={`${prof.name} ${prof.title}`}
          width="700"
          height="1050"
        />

        <div>
          <p class="prof-name">{prof.name} <span>{prof.title}</span></p>
          <p class="prof-org">{prof.org}</p>

          <dl class="prof-facts">
            {prof.facts.map((f) => (
              <Fragment>
                <dt>{f.label}</dt>
                <dd>{f.value}</dd>
              </Fragment>
            ))}
            <dt>信箱</dt>
            <dd><a class="prof-mail" href={`mailto:${prof.email}`}>{prof.email}</a></dd>
            <dt>專長</dt>
            <dd>{prof.expertise.join("、")}</dd>
          </dl>
        </div>
      </div>
    </section>

    {/* ---------- 經歷 ---------- */}
    <section class="page-section" id="experience">
      <h2 class="page-section-title">經歷</h2>

      <ol class="timeline">
        {experience.map((e) => (
          <li class="timeline-item">
            <span class="timeline-when">
              {e.start.replace(/-/g, ".")}
              {e.end ? ` – ${e.end === "迄今" ? "迄今" : e.end.replace(/-/g, ".")}` : " 起"}
            </span>
            <span class="timeline-what">{e.what}</span>
          </li>
        ))}
      </ol>
    </section>

    {/* ---------- 學術著作 ---------- */}
    <section class="page-section" id="publications">
      <h2 class="page-section-title">學術著作</h2>

      <h3 class="page-subsection-title">期刊論文（{journals.length} 篇）</h3>
      <BulletList items={lists.journals} />

      <h3 class="page-subsection-title">研討會論文（{conferences.length} 篇）</h3>
      <BulletList items={lists.conferences} />
    </section>

    {/* ---------- 研究計畫 ---------- */}
    <section class="page-section" id="projects">
      <h2 class="page-section-title">研究計畫</h2>

      <h3 class="page-subsection-title">國科會計畫（{prof.nscProjects.length} 項）</h3>
      <BulletList items={lists.nsc} />

      <h3 class="page-subsection-title">其他計畫（{prof.otherProjects.length} 項）</h3>
      <BulletList items={lists.other} />
    </section>

    {/* ---------- 專書與專利 ---------- */}
    <section class="page-section" id="books">
      <h2 class="page-section-title">專書與專利</h2>

      <div class="two-col">
        <div>
          <h3 class="page-subsection-title">專書</h3>
          <BulletList items={lists.books} />
        </div>

        <div>
          <h3 class="page-subsection-title">專利</h3>
          <BulletList items={lists.patents} />
        </div>
      </div>
    </section>

    {/* ---------- 榮譽 ---------- */}
    <section class="page-section" id="awards">
      <h2 class="page-section-title">榮譽</h2>
      <BulletList items={lists.awards} />
    </section>

    {/* ---------- 指導成果 ---------- */}
    <section class="page-section" id="guidance">
      <h2 class="page-section-title">指導成果</h2>
      <BulletList items={lists.guidance} />
    </section>
    </div>
  </div>
</BaseLayout>

<script>
  // 捲到哪一節，左側目錄就亮哪一條（HackMD 的做法）。
  //
  // 規則：視窗上方 35% 處畫一條判定線，「最後一個」頂端已經越過這條線的
  // 區塊就是目前所在。這樣任何時候都剛好有一節是亮的，不會空窗。
  //
  // 例外：頁面捲到底時直接亮最後一節。最後一節（指導成果）很短，
  // 頁面到底了它的頂端還在判定線下面，靠判定線永遠輪不到它。
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]");
  const sections = Array.from(
    document.querySelectorAll<HTMLElement>(".prof-main .page-section")
  );

  if (links.length && sections.length) {
    const setActive = (id: string) => {
      links.forEach((link) => {
        link.classList.toggle("is-active", link.dataset.tocLink === id);
      });
    };

    const update = () => {
      const doc = document.documentElement;
      const atBottom = window.innerHeight + window.scrollY >= doc.scrollHeight - 2;
      if (atBottom) {
        setActive(sections[sections.length - 1].id);
        return;
      }

      const line = window.innerHeight * 0.35;
      let current = sections[0].id;
      for (const section of sections) {
        if (section.getBoundingClientRect().top <= line) current = section.id;
      }
      setActive(current);
    };

    // scroll 事件每幀可能觸發好幾次，用 rAF 合併成每幀最多算一次
    let queued = false;
    const schedule = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        update();
      });
    };

    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule, { passive: true });
    // 「顯示更多」展開後頁面長度變了，但不會觸發 scroll，得自己重算
    document.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("[data-bullet-more]")) schedule();
    });
    update();
  }
</script>
