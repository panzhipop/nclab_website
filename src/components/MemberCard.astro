---
import { withBase } from "../lib/url";

const { name, photo = "" } = Astro.props;
---

<article class="member-card">
  {photo ? (
    /* alt 留空是刻意的：姓名就在旁邊，讀屏軟體再念一次照片等於重複 */
    <img class="member-photo" src={withBase(photo)} alt="" width="192" height="192" />
  ) : (
    /* 還沒有照片時用姓氏字元當佔位，比破圖圖示或空白框好辨認 */
    <div class="member-photo member-photo--empty" aria-hidden="true">{name.slice(0, 1)}</div>
  )}

  <p class="member-name">{name}</p>
</article>
