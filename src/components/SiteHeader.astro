---
import site from "../data/site.json";
import ThemeToggle from "./ThemeToggle.astro";
import { withBase } from "../lib/url";
const { current = "/" } = Astro.props;

// 標誌字樣的前兩個單字字首要上色（Network Computing Lab → N、C）。
// 從 site.shortName 拆出來而不是寫死字串，改名時這裡不用動。
const brandWords = site.shortName.split(" ");
const accentCount = 2;
---

<header class="site-header" id="siteHeader">
  {/* 標誌與語言列同一排，所以兩者是兄弟元素而不是分屬上下兩個容器 */}
  <div class="header-top">
    <a class="brand" href={withBase("/")}>
      <img src={withBase("/logo.png")} alt="" width="279" height="279" />
      <span class="brand-text">
        <span class="brand-org">{site.org} {site.name}</span>
        <span class="brand-name">
          {brandWords.map((word, i) => (
            <Fragment>
              {i > 0 && " "}
              {i < accentCount
                ? <span class="brand-initial">{word.charAt(0)}</span>
                : word.charAt(0)}
              {word.slice(1)}
            </Fragment>
          ))}
        </span>
      </span>
    </a>

    <div class="lang-bar">
      <a href={withBase("/")} aria-current="true">中文版</a>
      <!-- <a href="/en">English</a> -->
      <a href="">English</a>
      <ThemeToggle />
    </div>

    <button class="nav-toggle" type="button" aria-label="開啟選單"
            aria-expanded="false" aria-controls="mainNav">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="header-row">
    <nav class="nav" id="mainNav">
      {site.nav.map(item => (
        <a href={withBase(item.href)} aria-current={item.href === current ? "page" : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById("siteHeader");
  const btn = header?.querySelector(".nav-toggle");

  // 先一次確認兩個元素都在，後面就不用每行都寫 ?. 了
  if (header && btn) {
    const setOpen = (open: boolean) => {
      header.dataset.open = String(open);
      btn.setAttribute("aria-expanded", String(open));
      btn.setAttribute("aria-label", open ? "關閉選單" : "開啟選單");
    };

    btn.addEventListener("click", () => {
      setOpen(header.dataset.open !== "true");
    });

    document.addEventListener("click", (e) => {
      if (header.dataset.open === "true" && !header.contains(e.target as Node)) {
        setOpen(false);
      }
    });
  }
</script>
