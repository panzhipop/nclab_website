---
import allNews from "../data/news.json";

const { limit, showMore = false } = Astro.props;

// 日期由小到大，最新的一則排在最下面。
// 日期是 YYYY-MM-DD，字典序等同時間序，不需要轉成 Date 物件。
const ascending = [...allNews].sort((a, b) => a.date.localeCompare(b.date));

const visibleCount = limit ?? ascending.length;

// 有 limit 時要留下「最新的 N 則」—— 現在最新的在尾端，所以取後段。
const items = showMore ? ascending : ascending.slice(-visibleCount);

// 有「查看更多」時，全部消息都先渲染進 HTML，先藏起來的是比較舊的那些，
// 位置在列表上方。按鈕只負責把它們顯示出來，不換頁也不動捲軸。
const hiddenCount = showMore ? Math.max(0, ascending.length - visibleCount) : 0;
const hasMore = hiddenCount > 0;
---

<section class="news" data-expanded="false">
  <div class="wrap">
    <ul class="news-list">
      {items.map((item, i) => (
        <li class={i < hiddenCount ? "news-extra" : undefined}>
          <div class="news-item">
            <time class="news-date" datetime={item.date}>{item.date}</time>
            <span class="news-title">
              {item.tag && <span class="news-tag">【{item.tag}】</span>}
              {item.title}
            </span>
          </div>
        </li>
      ))}
    </ul>

    {hasMore && (
      <button class="more-btn" type="button" data-news-more aria-expanded="false">
        查看更多消息
      </button>
    )}
  </div>
</section>

<script>
  // Astro 會把這段打包成單一模組，不是每個元件實例各跑一次，
  // 所以這裡要處理頁面上所有的消息區塊
  document.querySelectorAll<HTMLButtonElement>("[data-news-more]").forEach((btn) => {
    const section = btn.closest<HTMLElement>(".news");
    if (!section) return;

    btn.addEventListener("click", () => {
      const expanded = section.dataset.expanded === "true";
      section.dataset.expanded = String(!expanded);
      btn.setAttribute("aria-expanded", String(!expanded));
      btn.textContent = expanded ? "查看更多消息" : "收合消息";
    });
  });
</script>
