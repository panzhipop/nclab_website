---
const { title, subtitle, image } = Astro.props;
---

<section
  class="hero"
  style={image ? `background-image:
    linear-gradient(105deg, rgba(6,22,49,.92) 0%, rgba(13,43,86,.72) 48%, rgba(29,79,146,.6) 100%),
    url('${image}'); background-size: cover; background-position: center;` : undefined}
>
  <div>
    <h1>{title}</h1>
    {subtitle && <p>{subtitle}</p>}
  </div>
</section>
