---
import site from "../data/site.json";
import { withBase } from "../lib/url";

// 淺藍橫條，預設顯示站台標語（原本放在 PageHero 的 subtitle）。
// 個別頁面要換成別的文字就傳 text，需要做成連結再傳 href。
const { text = site.tagline, href = null } = Astro.props;
---

{/*
  暫時隱藏整條淺藍橫條。
  8 個頁面的 <NewsTicker /> 呼叫都保留著沒動，所以要恢復只要把
  下面這段的註解符號拆掉即可，不必回頭改每個頁面。

  {text && (
    <div class="ticker">
      {href ? <a href={withBase(href)}>{text}</a> : text}
    </div>
  )}
*/}
