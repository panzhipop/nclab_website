---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import site from "../data/site.json";

const { title, description = site.tagline, current } = Astro.props;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title}｜${site.name}` : site.name}</title>
    <meta name="description" content={description} />

    {/* 分頁圖標用 header 那顆 logo；沒有這行的話瀏覽器會去抓預設的 /favicon.ico */}
    <link rel="icon" type="image/png" href="/logo.png" />

    {/*
      這段一定要放在 <head>、一定要 is:inline、一定要在 CSS 之前。
      目的是在瀏覽器第一次畫面之前就把 data-theme 設好，
      否則深色模式使用者會先看到一瞬間的白畫面（FOUC）。
      is:inline 是關鍵：沒加的話 Astro 會把它打包成延後載入的 module，就來不及了。
    */}
    <script is:inline>
      try {
        const saved = localStorage.getItem("theme");
        if (saved === "dark" || saved === "light") {
          document.documentElement.dataset.theme = saved;
        }
      } catch {}
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300;400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <SiteHeader current={current} />
    <main>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
